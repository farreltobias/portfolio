---
import Masthead from "../components/Masthead.astro";
import { allProjects, displayTitle, sheetNumberOf } from "../lib/projects";
import "../styles/home.css";
import "../styles/work.css";
import "../styles/about.css";

/* The cover sheet of the set: who Farrel is, how the work is done, and how it
   grew. Each habit points at the sheets that show it, so the page frames the
   evidence instead of retelling it. */
const projects = await allProjects();
const sheet = (id: string) => {
  const project = projects.find((entry) => entry.id === id);
  return project
    ? {
        id,
        number: sheetNumberOf(projects, id),
        title: displayTitle(project.data.title),
      }
    : null;
};

const habits = [
  {
    title: "Start from the pattern, not the ticket",
    text: "A request that keeps coming back usually points at a missing tool. I look at the pattern before solving the next instance of it.",
    sheets: ["rare-candy-customer-success"],
  },
  {
    title: "Build the smallest thing that changes the work",
    text: "A first version should remove the manual step people are stuck with, not reproduce a full product before anyone uses it.",
    sheets: ["pro-electric"],
  },
  {
    title: "Put the rules in the system",
    text: "Where people were holding state or refereeing by hand, the product should hold it instead: explicit, versioned and enforced.",
    sheets: ["rare-candy-auction-platform", "howdyship"],
  },
  {
    title: "Judge technical work by what it changes",
    text: "Architecture, performance and refactors earn their place through their effect on the business or the operation. I report a result only where it was measured.",
    sheets: [],
  },
].map((habit) => ({
  ...habit,
  sheets: habit.sheets.map(sheet).filter((entry) => entry !== null),
}));

/* The career to scale, one division per year. Months are counted from the
   start of the year, so a phase sits where it fell. */
const at = (year: number, month: number) => year + (month - 1) / 12;
const now = new Date();
const today = at(now.getFullYear(), now.getMonth() + 1);
const start = at(2020, 11);
const span = today - start;
const pos = (value: number) => ((value - start) / span) * 100;

const phases = [
  {
    from: at(2025, 3),
    to: today,
    years: "2025 – now",
    title: "Product Engineering",
    current: true,
  },
  {
    from: at(2022, 9),
    to: at(2025, 3),
    years: "2022 – 2025",
    title: "Client platforms, backend depth",
    current: false,
  },
  {
    from: start,
    to: at(2022, 7),
    years: "2020 – 2022",
    title: "Junior to technical lead",
    current: false,
  },
];

const ticks = Array.from(
  { length: now.getFullYear() - 2020 },
  (_, i) => 2021 + i,
).map((year) => ({ year, left: pos(year) }));

const [current, platforms, arbo] = phases;
const work = sheet("ottoset");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>About — Farrel</title>
    <meta
      name="description"
      content="Farrel is a Product Engineer in Brazil working remotely with international teams: from defining the problem to shipping the solution, on a backend foundation built since 2020."
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="sheet">
      <Masthead current="about" />

      <main id="main">
        <header class="page-head">
          <p class="leg zone">Profile</p>
          <div class="page-intro">
            <h1 class="disp page-title">Product Engineer.</h1>
            <p class="prose page-sub">
              I'm Farrel. I define the problem, shape what the product should
              do, make the technical decisions and carry the work into
              production. My foundation is backend engineering; my focus is
              software that simplifies how operations run, removing manual work
              people should not have to do.
            </p>
          </div>
          <dl class="spec">
            <div class="row">
              <dt class="leg">Role</dt>
              <dd class="v">Product Engineer</dd>
            </div>
            <div class="row">
              <dt class="leg">In software since</dt>
              <dd class="v">2020</dd>
            </div>
            <div class="row">
              <dt class="leg">Base</dt>
              <dd class="v">Brazil — remote</dd>
            </div>
            <div class="row">
              <dt class="leg">Languages</dt>
              <dd class="v">English, Portuguese</dd>
            </div>
          </dl>
        </header>

        <!-- ------------------------------------------------------ approach -- -->
        <section class="sheet-band" aria-labelledby="approach-title">
          <div class="sheet-band-grid">
            <p class="leg">Approach</p>
            <div class="sheet-band-body">
              <h2 class="sheet-band-title" id="approach-title">How I work</h2>
              <p class="sheet-band-note">
                Four habits, each with the sheets that show it.
              </p>
              <ol class="habits">
                {
                  habits.map((habit) => (
                    <li class="habit">
                      <h3 class="habit-title">{habit.title}</h3>
                      <p class="habit-text">{habit.text}</p>
                      <p class="habit-ref">
                        {habit.sheets.length > 0 ? (
                          habit.sheets.map((ref) => (
                            <a class="ref-link" href={`/work/${ref.id}`}>
                              <span class="ref-no">Sheet {ref.number}</span>
                              <span class="ref-title">{ref.title}</span>
                            </a>
                          ))
                        ) : (
                          <a class="ref-link" href="/work">
                            <span class="ref-no">Every sheet</span>
                            <span class="ref-title">
                              Outcome, or "not yet measured"
                            </span>
                          </a>
                        )}
                      </p>
                    </li>
                  ))
                }
              </ol>
            </div>
          </div>
        </section>

        <!-- --------------------------------------------------- progression -- -->
        <section class="sheet-band" aria-labelledby="progression-title">
          <div class="sheet-band-grid">
            <p class="leg">Progression</p>
            <div class="sheet-band-body">
              <h2 class="sheet-band-title" id="progression-title">
                How the work grew
              </h2>
              <p class="sheet-band-note">
                From implementation toward owning the product decisions.
              </p>

              <figure class="scale">
                <div class="scale-bar">
                  {
                    phases.map((phase) => (
                      <span
                        class:list={["scale-seg", { "is-current": phase.current }]}
                        style={`left:${pos(phase.from)}%;width:${pos(phase.to) - pos(phase.from)}%`}
                      />
                    ))
                  }
                  {
                    ticks.map((tick) => (
                      <span class="scale-tick" style={`left:${tick.left}%`}>
                        <span class="scale-year">{tick.year}</span>
                      </span>
                    ))
                  }
                </div>
                <figcaption class="scale-key">
                  <span>One division per year, from November 2020</span>
                  <span class="scale-key-item">
                    <span class="scale-sw is-current" aria-hidden="true"
                    ></span>Product Engineering
                  </span>
                  <span class="scale-key-item">
                    <span class="scale-sw" aria-hidden="true"></span>Earlier
                    work
                  </span>
                </figcaption>
              </figure>

              <div class="phases">
                <article class="phase is-current">
                  <p class="phase-years">{current.years}</p>
                  <div class="phase-body">
                    <h3 class="phase-title">{current.title}</h3>
                    <p>
                      My work moved from implementing what was asked to deciding
                      what should be built: defining the problem, shaping scope
                      and product behaviour, making the technical decisions and
                      carrying the solution through delivery.
                    </p>
                    <p>
                      At Rare Candy, through Howdy, that has meant internal
                      tooling, automation, marketplace systems and the auction
                      platform, working remotely with an international team. Through
                      Farrel.tech I also work directly with clients, such as
                      Pro Electric, and build my own products, among them <a href="/work/ddd-toolkit"
                        >DDD Toolkit</a
                      >, an early-stage open-source toolkit for domain-driven
                      design in TypeScript.
                    </p>
                  </div>
                </article>

                <article class="phase">
                  <p class="phase-years">{platforms.years}</p>
                  <div class="phase-body">
                    <h3 class="phase-title">{platforms.title}</h3>
                    <p>
                      Client and product work across companies: institutional
                      websites and CMS-backed platforms at Let's and DoroTech,
                      a period working independently, then production systems
                      at ZRP. Along the way the work went deeper into backend
                      engineering, architecture, performance, authentication,
                      CI/CD, integrations and modernizing older applications.
                      {
                        work && (
                          <>
                            {" "}
                            <a href={`/work/${work.id}`}>{work.title}</a> (Sheet{" "}
                            {work.number}) is from this period.
                          </>
                        )
                      }
                    </p>
                  </div>
                </article>

                <article class="phase">
                  <p class="phase-years">{arbo.years}</p>
                  <div class="phase-body">
                    <h3 class="phase-title">{arbo.title}</h3>
                    <p>
                      I started professionally at Arbo, on a real estate
                      platform, as a junior full stack engineer. I soon took on
                      backend systems, integrations and automation, including
                      the systems that distributed property listings to
                      marketplaces and helped increase lead generation, and
                      moved into the technical lead role.
                    </p>
                  </div>
                </article>
              </div>

              <a class="more-link" href="/work">
                <span class="more-label">See the work</span>
                <span class="vh">, </span>
                <span class="more-count">
                  {`${projects.length} ${projects.length === 1 ? "project" : "projects"}`}
                </span>
              </a>
            </div>
          </div>
        </section>
      </main>

      <footer class="closing">
        <div class="closing-head">
          <div>
            <h2>Have a product or operations problem to solve?</h2>
            <p class="sub">
              Open to Product Engineering roles and contract work.
            </p>
          </div>
          <a class="control" href="/contact">
            <span class="bar">Let's talk</span>
            <span class="chip hatch" aria-hidden="true"></span>
          </a>
        </div>
      </footer>
    </div>
  </body>
</html>
