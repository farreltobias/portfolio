---
/* A measured figure at collision scale. It may wrap at its spaces, around the
   arrow or between words, but never inside a word: a word joiner after each
   dash keeps "1–2/week" or "In-platform" whole. No part is set nowrap, so a
   figure of any shape stays inside its column. */
interface Props {
  value: string;
  class?: string;
  /* What a screen reader hears before the figure, e.g. "Measured", since the
     colour that tells measured from changed is not spoken. */
  kind?: string;
}

const { value, class: className, kind } = Astro.props;
const WORD_JOINER = "\u2060";
const text = value.replace(/([-–—/])/g, `$1${WORD_JOINER}`);

/* The figure in words: "~4/day → 1–2/week" is read as "before about 4 per
   day, after 1 to 2 per week", not "tilde … rightwards arrow". */
const [before, after] = value.split("→").map((part) =>
  part
    .trim()
    .replace(/^~\s*/, "about ")
    .replace(/(\d)\s*[–-]\s*(\d)/g, "$1 to $2")
    .replace(/\//g, " per "),
);
const spoken = after
  ? `${kind ? `${kind}: ` : ""}before ${before}, after ${after}`
  : `${kind ? `${kind}: ` : ""}${value}`;
---

<p class={className}>
  <span class="vh">{spoken}</span>
  <span aria-hidden="true">{text}</span>
</p>
