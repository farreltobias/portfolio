---
import * as prismic from '@prismicio/client';
import MobileNav from '@/islands/MobileNav';
import { linkResolver } from '@/lib/linkResolver';
import type { NavigationDocument } from '@/prismicio/types';

interface ResolvedLink {
  label: string;
  href: string;
}

export interface Props {
  navigation: NavigationDocument | null;
  currentPath: string;
}

const { navigation, currentPath } = Astro.props;
const data = navigation?.data;

const resolvedNavLinks: ResolvedLink[] = [];
for (const item of data?.nav_links ?? []) {
  if (!prismic.isFilled.contentRelationship(item.page)) continue;
  const href = prismic.asLink(item.page, { linkResolver }) ?? '/';
  resolvedNavLinks.push({ label: item.label ?? '', href });
}

const ctaLabel = data?.nav_cta_label ?? null;
const ctaHref =
  data?.nav_cta_link && prismic.isFilled.link(data.nav_cta_link)
    ? (prismic.asLink(data.nav_cta_link, {
        linkResolver,
      }) ?? null)
    : null;

const isActive = (href: string) =>
  href === '/'
    ? currentPath === '/'
    : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header
  class="sticky top-0"
  style="z-index: var(--z-sticky); background-color: var(--color-surface); border-bottom: 1px solid var(--color-border);"
>
  <div
    class="mx-auto flex items-center justify-between px-6 lg:px-16"
    style="max-width: var(--container-xl); height: 4rem;"
  >
    <!-- Logo -->
    <a
      href="/"
      class="text-sm font-semibold tracking-wide"
      style="color: var(--color-text-primary); text-decoration: none;"
      aria-label="Farrel — home"
    >
      {data?.logo_text ?? 'Farrel'}
    </a>

    <!-- Desktop nav -->
    <nav aria-label="Primary navigation" class="hidden md:block">
      <ul class="flex items-center gap-1" role="list">
        {resolvedNavLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class="rounded px-3 py-2 text-sm transition-colors duration-150"
              style={
                isActive(link.href)
                  ? 'color: var(--color-accent); background-color: var(--color-accent-subtle);'
                  : 'color: var(--color-text-muted);'
              }
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <!-- Desktop CTA -->
      {ctaLabel && ctaHref && (
        <a
          href={ctaHref}
          class="hidden rounded px-4 py-2 text-sm font-semibold md:inline-flex"
          style="background-color: var(--color-accent); color: var(--color-bg); text-decoration: none;"
        >
          {ctaLabel}
        </a>
      )}

      <!-- Mobile nav (React island) -->
      <div class="md:hidden" style="color: var(--color-text-primary);">
        <MobileNav
          client:load
          navLinks={resolvedNavLinks}
          ctaLabel={ctaLabel ?? undefined}
          ctaHref={ctaHref ?? undefined}
          currentPath={currentPath}
        />
      </div>
    </div>
  </div>
</header>
