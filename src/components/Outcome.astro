---
import type { CollectionEntry } from "astro:content";
import Figure from "./Figure.astro";

/* The outcome field of a sheet, in one of three states:
   - a measured figure, set in magenta over its hatch band and labelled with
     the quantity it measures; the sentence stays on the case study, so the
     figure is never stated twice;
   - a qualitative result, stated in ink and never given the measured mark;
   - nothing recorded, shown as the mask, never as an invented claim. */
interface Props {
  project: CollectionEntry<"projects">["data"];
}

const { outcome, outcomeFigure, outcomeMetric } = Astro.props.project;
const label =
  outcomeFigure && outcomeMetric ? `Outcome — ${outcomeMetric}` : "Outcome";
---

<p class="leg k">{label}</p>
{
  outcomeFigure ? (
    <Fragment>
      <Figure class="delta" value={outcomeFigure} />
      <div class="band hatch-mag" aria-hidden="true" />
    </Fragment>
  ) : outcome ? (
    <p class="outcome-text">{outcome}</p>
  ) : (
    <Fragment>
      <p class="unmeasured">Shipped — not yet measured</p>
      <div class="unmeasured-band mask-dot" aria-hidden="true" />
    </Fragment>
  )
}
