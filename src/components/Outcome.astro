---
import type { CollectionEntry } from "astro:content";
import Figure from "./Figure.astro";

/* The outcome field of a sheet, in one of three states:
   - a measured before → after, only when both the figure and the quantity it
     measures are recorded: set in magenta over its hatch band, labelled with
     the quantity; the sentence stays on the case study, so the figure is
     never stated twice;
   - a qualitative result, stated in ink and never given the measured mark;
   - nothing recorded, shown as the mask, never as an invented claim; the
     words say whether the work has shipped or is still in progress. */
interface Props {
  project: CollectionEntry<"projects">["data"];
}

const { outcome, outcomeFigure, outcomeMetric, stage } = Astro.props.project;
const measured = Boolean(outcomeFigure && outcomeMetric);
const label = measured ? `Outcome — ${outcomeMetric}` : "Outcome";
---

<p class="leg k">{label}</p>
{
  measured && outcomeFigure ? (
    <Fragment>
      <Figure class="delta" value={outcomeFigure} />
      <div class="band hatch-mag" aria-hidden="true" />
    </Fragment>
  ) : outcome ? (
    <p class="outcome-text">{outcome}</p>
  ) : (
    <Fragment>
      <p class="unmeasured">
        {stage === "in-progress" ? "In progress" : "Shipped"} — not yet measured
      </p>
      <div class="unmeasured-band mask-dot" aria-hidden="true" />
    </Fragment>
  )
}
