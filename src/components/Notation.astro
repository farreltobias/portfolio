---
/* The key to every mark a sheet carries. The magenta hatch marks a recorded
   before → after; it does not claim every one is a measured quantity. */
---

<section class="notation" aria-label="Notation key">
  <p class="leg">Notation</p>
  <div class="keys">
    <div class="k">
      <div class="sw hatch-cross" aria-hidden="true"></div>
      <p class="kl">Constraint</p>
    </div>
    <div class="k">
      <div class="sw hatch-mag" aria-hidden="true"></div>
      <p class="kl">Before → after</p>
    </div>
    <div class="k">
      <div class="sw mask-dot" aria-hidden="true"></div>
      <p class="kl">Not yet measured</p>
    </div>
  </div>
</section>
