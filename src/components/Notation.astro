---
/* The key to every mark a sheet carries. Magenta marks a measured before →
   after; a recorded change of state is drawn in ink and keyed apart. */
---

<section class="notation" aria-label="Notation key">
  <p class="leg">Notation</p>
  <div class="keys">
    <div class="k">
      <div class="sw hatch-cross" aria-hidden="true"></div>
      <p class="kl">Constraint</p>
    </div>
    <div class="k">
      <div class="sw hatch-mag" aria-hidden="true"></div>
      <p class="kl">Before → after, measured</p>
    </div>
    <div class="k">
      <div class="sw hatch-ink" aria-hidden="true"></div>
      <p class="kl">Before → after, changed</p>
    </div>
    <div class="k">
      <div class="sw mask-dot" aria-hidden="true"></div>
      <p class="kl">Not yet measured</p>
    </div>
  </div>
</section>
