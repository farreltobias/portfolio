---
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getNavigation, getSettings } from '@/prismicio/queries';
import type { NavigationDocument, SettingsDocument } from '@/prismicio/types';

export interface Props {
  title: string;
  description?: string;
  canonical: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}

const { description, ogImage, ogImageWidth, ogImageHeight, ...restProps } =
  Astro.props;
const currentPath = Astro.url.pathname;

const [settingsResult, navigationResult] = await Promise.allSettled([
  getSettings(),
  getNavigation(),
] as const);

if (import.meta.env.DEV) {
  if (settingsResult.status === 'rejected') {
    console.error('[CMS] Settings fetch failed:', settingsResult.reason);
  }
  if (navigationResult.status === 'rejected') {
    console.error('[CMS] Navigation fetch failed:', navigationResult.reason);
  }
}

const settings: SettingsDocument | null =
  settingsResult.status === 'fulfilled' ? settingsResult.value : null;
const navigation: NavigationDocument | null =
  navigationResult.status === 'fulfilled' ? navigationResult.value : null;

const siteName = settings?.data.site_name ?? 'Farrel';

// Settings act as global fallbacks; page values always take precedence.
const effectiveDescription =
  description ?? settings?.data.site_description ?? '';

const settingsOgImage = settings?.data.og_image;
const usesSettingsOgImage = !ogImage && Boolean(settingsOgImage?.url);

const effectiveOgImage = ogImage ?? settingsOgImage?.url ?? undefined;
const effectiveOgImageWidth =
  ogImageWidth ??
  (usesSettingsOgImage ? settingsOgImage?.dimensions?.width : undefined);
const effectiveOgImageHeight =
  ogImageHeight ??
  (usesSettingsOgImage ? settingsOgImage?.dimensions?.height : undefined);
---

<BaseLayout
  {...restProps}
  siteName={siteName}
  description={effectiveDescription}
  ogImage={effectiveOgImage}
  ogImageWidth={effectiveOgImageWidth}
  ogImageHeight={effectiveOgImageHeight}
>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <Header navigation={navigation} currentPath={currentPath} />
  <main id="main-content" tabindex="-1">
    <slot />
  </main>
  <Footer navigation={navigation} settings={settings} />
</BaseLayout>
