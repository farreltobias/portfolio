# ─── Prismic ─────────────────────────────────────────────────────────────────
# Your Prismic repository name (visible in the Prismic dashboard URL).
# Example: if your repository URL is https://my-repo.prismic.io, set this to my-repo.
PRISMIC_ENVIRONMENT=

# Required if your Prismic repository access is set to private.
# Generate at: Prismic dashboard → Settings → API & Security → Generate an access token
PRISMIC_ACCESS_TOKEN=

# Required for running `pnpm codegen` (fetches Custom Type and Slice models from the API).
# Generate at: Prismic dashboard → Settings → API & Security → Custom Types API → Add a token
PRISMIC_CUSTOM_TYPES_API_TOKEN=
