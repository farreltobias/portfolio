{
  "id": "case_study",
  "label": "Case Study",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID",
          "placeholder": "my-case-study"
        }
      },
      "title": {
        "type": "StructuredText",
        "config": {
          "single": "heading1",
          "label": "Title"
        }
      },
      "company": {
        "type": "Text",
        "config": {
          "label": "Company",
          "placeholder": "Company name or anonymized descriptor"
        }
      },
      "role": {
        "type": "Text",
        "config": {
          "label": "Role",
          "placeholder": "e.g. Lead Backend Engineer"
        }
      },
      "timeline": {
        "type": "Text",
        "config": {
          "label": "Timeline",
          "placeholder": "e.g. Q1–Q3 2023"
        }
      },
      "tech_tags": {
        "type": "Group",
        "config": {
          "label": "Tech Tags",
          "fields": {
            "tag": {
              "type": "Text",
              "config": {
                "label": "Tag",
                "placeholder": "e.g. TypeScript"
              }
            }
          }
        }
      },
      "outcome_summary": {
        "type": "Text",
        "config": {
          "label": "Outcome Summary",
          "placeholder": "One-line outcome for cards and list views"
        }
      },
      "cover_image": {
        "type": "Image",
        "config": {
          "label": "Cover Image",
          "constraint": {},
          "thumbnails": []
        }
      },
      "is_featured": {
        "type": "Boolean",
        "config": {
          "label": "Feature on Home Page",
          "default_value": false
        }
      },
      "sort_order": {
        "type": "Number",
        "config": {
          "label": "Sort Order",
          "placeholder": "Lower numbers appear first"
        }
      }
    },
    "Body": {
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "labels": {},
          "choices": {
            "problem": {
              "type": "SharedSlice"
            },
            "architecture": {
              "type": "SharedSlice"
            },
            "implementation": {
              "type": "SharedSlice"
            },
            "results": {
              "type": "SharedSlice"
            },
            "reflection": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO": {
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta Description",
          "placeholder": "120–160 characters"
        }
      },
      "og_image": {
        "type": "Image",
        "config": {
          "label": "OG Image",
          "constraint": {},
          "thumbnails": []
        }
      }
    }
  }
}
